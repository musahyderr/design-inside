{
  "name": "designinside",
  "version": "0.1.0",
  "description": "Click any element on your localhost site, change it visually, and designinside writes the change into your real source files and commits it.",
  "keywords": [
    "visual-editor",
    "localhost",
    "claude-code",
    "css",
    "tailwind",
    "ai-agent",
    "gemini-cli",
    "codex",
    "localhost-only"
  ],
  "homepage": "https://github.com/musahyderr/designinside#readme",
  "bugs": "https://github.com/musahyderr/designinside/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/musahyderr/designinside.git"
  },
  "license": "MIT",
  "author": "designinside contributors",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "designinside": "dist/designinside.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.js",
    "start": "node bin/cli.js",
    "check": "bash scripts/check.sh"
  },
  "dependencies": {
    "parse5": "^8.1.1",
    "postcss": "^8.5.33"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1"
  }
}
